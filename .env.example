# Enigma platform auth (N0DE-compatible)
# Copy this file to .env.local and fill in real values, then restart `npm run dev`.
#
# Local dev option A — Vite proxy (avoids CORS): leave base URL empty
# VITE_API_BASE_URL=
#
# Local dev option B — direct API URL:
# VITE_API_BASE_URL=https://enigmaincenterpriseapp.azurewebsites.net
VITE_API_BASE_URL=
VITE_API_KEY=your_api_key_here
VITE_APPLICATION_ID=3FC61D34-A023-4974-AB02-1274D2061897

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Optional — Microsoft SSO (MSAL in browser)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common
VITE_AZURE_REDIRECT_URI=http://localhost:5173/login/microsoft/callback
VITE_AZURE_API_SCOPE=

# CMS (existing)
VITE_CMS_BASE_URL=
VITE_CMS_PROJECT_ID=
VITE_CMS_API_KEY=
